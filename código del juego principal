        self.label_falladosiz.config(text=f"Fallados: {self.estadisticas[1]['fallados']}")
        self.label_perdidosiz.config(text=f"Perdidos: {self.estadisticas[1]['perdidos']}")
        self.label_cobrosiz.config(text=f"Cobros: {self.estadisticas[1]['cobros']}")

        # Jugador 2
        self.label_golesder.config(text=f"Goles: {self.estadisticas[2]['goles']}")
        self.label_falladosder.config(text=f"Fallados: {self.estadisticas[2]['fallados']}")
        self.label_perdidosder.config(text=f"Perdidos: {self.estadisticas[2]['perdidos']}")
        self.label_cobrosder.config(text=f"Cobros: {self.estadisticas[2]['cobros']}")

