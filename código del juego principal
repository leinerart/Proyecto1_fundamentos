import tkinter as tk
from tkinter import messagebox
from tkinter.constants import RIDGE
from PIL import Image, ImageTk
import pygame
import socket
import threading #para ejecutar tareas en paralelo
import time
import random

#clase principal del juego
class PantallaJuego:
    def __init__(self, root, selecciones, primer_jugador):
        self.root = root
        self.root.title("Penales")
        self.root.geometry("1450x730")

        # Inicializar pygame mixer para sonidos
        pygame.mixer.init()

        # Guardar las selecciones y quién empieza primero
        self.selecciones = selecciones
        self.primer_jugador = primer_jugador

        # Variables del juego
        self.tiros_totales = 10  # 5 por equipo
        self.tiros_realizados = 0
        self.turno_actual = primer_jugador  # 1 o 2
        self.en_juego = False
        self.esperando_tiro = False

        # diccionario que guarda las estadísticas
        self.estadisticas = {
            1: {'goles': 0, 'fallados': 0, 'perdidos': 0, 'cobros': 0},
            2: {'goles': 0, 'fallados': 0, 'perdidos': 0, 'cobros': 0}
        }

        # Conexión socket
        self.SERVER_IP = "192.168.97.248"
        self.PORT = 1717
        self.connection_active = False
        self.client_socket = None

        print("Selecciones recibidas:", selecciones)
        print("Primer jugador:", primer_jugador)

        self.cargar_imagenes()
        self.mostrar_pantalla_juego() #construye la pantalla junto con los labels
        self.conectar_servidor()
        self.iniciar_juego()

    def cargar_sonidos(self):
        """Carga todos los sonidos del juego"""
        try:
            self.sonido_largo = pygame.mixer.Sound("sonido_largo.mp3")
            self.sonido_corto = pygame.mixer.Sound("sonido_corto.mp3")
            self.sonido_porras = pygame.mixer.Sound("porras.mp3")
            self.sonido_abucheos = pygame.mixer.Sound("abucheos.mp3")
        except Exception as e:
            print(f"Error cargando sonidos: {e}")

#PARTE LÓGICA DE LA CONEXION A LA RASPBERRY Y LAS PALETAS

    #crea el servidor para conectarse a la raspberry por el puerto 1717
    def conectar_servidor(self):
        """Conectar al servidor de las paletas"""
        try:
            self.client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self.client_socket.connect((self.SERVER_IP, self.PORT))
            self.connection_active = True

            # Iniciar hilo para recibir mensajes
            threading.Thread(target=self.recibir_mensajes, daemon=True).start()
            print("Conectado al servidor de paletas")

        except Exception as e:
            print(f"Error conectando al servidor: {e}")
            self.connection_active = False

    def recibir_mensajes(self):
        """Recibir mensajes del servidor en un hilo separado"""
        while self.connection_active:
            try:
                data = self.client_socket.recv(1024).decode()
                if data:
                    self.procesar_mensaje_paletas(data)
            except Exception as e:
                if self.connection_active:
                    print(f"Error en conexión: {e}")
                break

    def procesar_mensaje_paletas(self, mensaje):
        """Procesar los resultados de los tiros"""
        if mensaje.startswith("TIRO_RESULTADO:"):
            resultado = mensaje.split(":")[1]
            print(f"Resultado del tiro: {resultado}")

            # Procesar en el hilo principal de Tkinter
            self.root.after(0, self.procesar_resultado_tiro, resultado)

    def iniciar_juego(self):
        """Inicia la secuencia del juego"""
        self.cargar_sonidos()
        self.en_juego = True

        # Sonido largo de inicio
        self.sonido_largo.play()
        self.root.after(3000, self.iniciar_primer_tiro)  # Esperar 3 segundos

    def iniciar_primer_tiro(self):
        """Inicia el primer tiro del juego"""
        self.sonido_corto.play()  # Silbato corto para iniciar cobros
        self.root.after(100, self.iniciar_turno)

    def iniciar_turno(self):
        """Inicia un nuevo turno de tiro"""
        if self.tiros_realizados >= self.tiros_totales:
            self.finalizar_juego()
            return

        self.esperando_tiro = True
        self.actualizar_indicadores_turno() #llama a la funcion que le cambia el color a los bordes

        # Elegir algoritmo ALEATORIO para este cobro (AN1, AN2 o AN3)
        algoritmo = random.randint(1, 3)

        # Enviar comando a Raspberry con el algoritmo aleatorio
        if self.connection_active:
            try:
                comando = f"INICIO_TIRO:{algoritmo}:{self.turno_actual}"
                self.client_socket.send(comando.encode())
                print(f"Enviado {comando} - Equipo {self.turno_actual} juega (AN{algoritmo})")
            except Exception as e:
                print(f"Error enviando INICIO_TIRO: {e}")

        # Temporizador de 10 segundos para el tiro
        self.timer_tiro = self.root.after(10000, self.tiempo_agotado)

    def tiempo_agotado(self):
        """Se agotó el tiempo para el tiro"""
        if self.esperando_tiro:
            print("Tiempo agotado - tiro perdido")
            self.procesar_resultado_tiro("fallado")

    #se encarga de analizar el tiro
    def procesar_resultado_tiro(self, resultado):
        """Procesa el resultado de un tiro"""
        if not self.esperando_tiro:
            return

        # Cancelar timer si aún está activo
        if hasattr(self, 'timer_tiro'):
            self.root.after_cancel(self.timer_tiro)

        self.esperando_tiro = False
        jugador = self.turno_actual

        # Actualizar el diccionario estadísticas
        self.estadisticas[jugador]['cobros'] += 1
        self.tiros_realizados += 1

        if resultado == "gol":
            self.estadisticas[jugador]['goles'] += 1
            self.sonido_porras.play()
            print("GOL")
        elif resultado == "atajado":
            self.estadisticas[jugador]['fallados'] += 1
            self.sonido_abucheos.play()
            print("ATAJADO")
        else:  # fallado
            self.estadisticas[jugador]['perdidos'] += 1
            self.sonido_abucheos.play()
            print("TIRO FALLADO")

        # Actualizar interfaz
        self.actualizar_estadisticas()#llama a la función actualizar estadísticas

        # Esperar 5 segundos antes del siguiente turno
        self.root.after(5000, self.siguiente_turno)

    def siguiente_turno(self):
        """Pasa al siguiente turno"""
        # Cambiar turno (alternar entre 1 y 2)
        self.turno_actual = 2 if self.turno_actual == 1 else 1

        # Silbato corto para nuevo turno y luego iniciar tiro
        self.sonido_corto.play()
        self.root.after(100, self.iniciar_turno)  # Pequeño delay después del sonido

    def finalizar_juego(self):
        """Finaliza el juego"""
        self.en_juego = False
        self.connection_active = False

        # Enviar comando para apagar leds de equipo
        if self.client_socket:
            try:
                self.client_socket.send("FIN_JUEGO".encode())
            except:
                pass

        # Sonido largo de finalización
        self.sonido_largo.play()

        # Mostrar resultado final
        goles_jugador1 = self.estadisticas[1]['goles']
        goles_jugador2 = self.estadisticas[2]['goles']

        if goles_jugador1 > goles_jugador2:
            mensaje = "¡JUGADOR 1 GANA!"
        elif goles_jugador2 > goles_jugador1:
            mensaje = "¡JUGADOR 2 GANA!"
        else:
            mensaje = "¡EMPATE!"

        messagebox.showinfo("FIN DEL JUEGO",
                            f"{mensaje}\n\n"
                            f"Jugador 1: {goles_jugador1} goles\n"
                            f"Jugador 2: {goles_jugador2} goles")

        # Cerrar conexión
        if self.client_socket:
            try:
                self.client_socket.send("EXIT".encode())
                self.client_socket.close()
            except:
                pass

    def actualizar_indicadores_turno(self):
        """Actualiza los colores de los bordes para indicar quién juega"""
        # Resetear todos los bordes
        self.label_artilleroiz.config(bg="gray")
        self.label_porteroiz.config(bg="gray")
        self.label_artilleroder.config(bg="gray")
        self.label_porteroder.config(bg="gray")

        # Resaltar jugadores activos, verde para el artillero y amarillo para el portero
        if self.turno_actual == 1:
            self.label_artilleroiz.config(bg="green")  # Artillero jugando
            self.label_porteroder.config(bg="yellow")  # Portero rival
        else:
            self.label_artilleroder.config(bg="green")  # Artillero jugando
            self.label_porteroiz.config(bg="yellow")  # Portero rival

    #modifica los labels de la información para actualizarlos
    def actualizar_estadisticas(self):
