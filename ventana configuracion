    def limpiar_interfaz(self):
        """Limpiar todos los widgets de la interfaz"""
        for widget in self.root.winfo_children():
            widget.destroy()

    def conectar_servidor(self):
        """Conectar al servidor de la Raspberry"""
        try:
            self.client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self.client_socket.connect((SERVER_IP, PORT))
            self.connection_active = True

            # Iniciar hilo para recibir mensajes
            threading.Thread(target=self.recibir_mensajes, daemon=True).start()

        except Exception as e:
            print(f"Error conectando al servidor: {e}")
            self.connection_active = False

    def recibir_mensajes(self):
        """Recibir mensajes del servidor en un hilo separado"""
        while self.connection_active:
            try:
                data = self.client_socket.recv(1024).decode()
                if data:
                    self.procesar_mensaje(data)
            except Exception as e:
                if self.connection_active:
                    print(f"Error en conexión: {e}")
                break

    def procesar_mensaje(self, mensaje):
        """Procesar los mensajes recibidos del servidor"""
        if mensaje.startswith("BUTTON:"):
            partes = mensaje.split(":")
            if len(partes) >= 3:
                boton_num = int(partes[1])
                pot_val = int(partes[2])

                # Actualizar interfaz en el hilo principal
                self.root.after(0, self.actualizar_seleccion, boton_num, pot_val)

    def actualizar_seleccion(self, boton_num, pot_val):
        """Actualizar la selección del botón en la interfaz"""
        self.selected_button = boton_num

        # Actualizar colores de los bordes
        self.boton1.config(bg="gray")
        self.boton2.config(bg="gray")
        self.boton3.config(bg="gray")

        # Resaltar borde del botón seleccionado
        if boton_num == 0:
            self.boton1.config(bg="blue")
        elif boton_num == 1:
            self.boton2.config(bg="blue")
        elif boton_num == 2:
            self.boton3.config(bg="blue")

    def presionar_enter(self, event=None):
        """Procesar la tecla ENTER - confirmar selección"""
        if self.connection_active and self.selected_button >= 0:
            try:
                # Guardar la selección según el estado actual
                self.guardar_seleccion()

                # Avanzar al siguiente estado
                hay_mas_estados = self.avanzar_estado()

                # Solo actualizar la interfaz si hay más estados
                if hay_mas_estados:
                    self.crear_interfaz_equipos()

            except Exception as e:
                print(f"Error procesando selección: {e}")

    #funcion que se encarga de guardar que artillero, portero y equipo seleccionó cada jugador
    def guardar_seleccion(self):
