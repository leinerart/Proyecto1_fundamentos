    def get_nombre_equipo(self, indice):
        """Obtener el nombre del equipo basado en el índice"""
        equipos = ["Argentina", "Portugal", "Francia"]
        return equipos[indice] if 0 <= indice < len(equipos) else "Desconocido"

    #función que se encarga del flujo de selección
    def avanzar_estado(self):
        """Avanzar al siguiente estado del flujo"""
        estados = [
            "jugador1_equipo", "jugador1_artillero", "jugador1_portero",
            "jugador2_equipo", "jugador2_artillero", "jugador2_portero"
        ]
        current_index = estados.index(self.estado_actual)
        print(f"Estado actual: {self.estado_actual}, Índice: {current_index}")
        if current_index < len(estados) - 1:
            self.estado_actual = estados[current_index + 1]
            print(f"Avanzando a: {self.estado_actual}")
            return True
        else:
            self.estado_actual = "finalizado"  #estado para indicar que terminó
            self.mostrar_pantalla_final()
            return False  # Indica que se llegó al final

